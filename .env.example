# !!! STOP - NEVYPLŇUJ TENHLE SOUBOR SKUTEČNÝMI HODNOTAMI !!!
# Je součástí veřejného gitu - cokoliv sem napíšeš, uvidí každý na
# GitHubu do pár minut. Slouží jen jako seznam proměnných, VŽDY se
# všemi hodnotami prázdnými.
#
# Skutečné klíče patří:
# - lokálně: do souboru `.env` (bez ".example", ten je v .gitignore) -
#   `cp .env.example .env` a vyplň teprve TAM,
# - na Vercelu: do Project -> Settings -> Environment Variables,
#   NIKDY do souboru v repozitáři.

# Server
PORT=3000
SESSION_SECRET=change-me
BASE_URL=http://localhost:3000
# Nastav před nasazením mimo localhost - appka nemá vlastní účty, tohle
# jediné heslo (HTTP Basic Auth, uživatelské jméno je libovolné) chrání
# celou appku a tvoje připojené API klíče. Nech prázdné pro lokální vývoj.
APP_PASSWORD=

# Mapy.com (https://developer.mapy.com/ -> vytvořit projekt a API klíč)
MAPY_API_KEY=

# Strava OAuth app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback
# Volitelné: vyplň po prvním připojení Strava (appka ti ho zobrazí), pokud
# nasazuješ appku na hosting bez trvalého disku (viz README -> Nasazení).
STRAVA_REFRESH_TOKEN=

# Intervals.icu (Settings -> Developer Settings -> API Key)
INTERVALS_API_KEY=
# Athlete ID z URL v intervals.icu, např. "i123456" (nebo "0" pro sebe sama u některých endpointů)
INTERVALS_ATHLETE_ID=

# Variant 2, Milestone 1 (viz docs/ARCHITECTURE.md) - volitelný alternativní
# routovací engine (self-hosted BRouter) pro bike+road trasy. Nech prázdné /
# na "mapy", dokud Milestone 1 neověříš - jde o vývojářský přepínač, ne
# uživatelskou volbu.
ROUTE_ENGINE=mapy
# URL běžícího BRouter serveru (viz brouter/README.md), např.
# http://localhost:17777 lokálně nebo https://find-router-brouter.onrender.com
BROUTER_URL=
