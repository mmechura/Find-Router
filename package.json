{
  "name": "find-router",
  "version": "0.1.0",
  "private": true,
  "description": "Generuje ideální trasu na Mapy.com podle plánovaného tréninku z intervals.icu a aktuálního stavu ze Strava.",
  "type": "module",
  "scripts": {
